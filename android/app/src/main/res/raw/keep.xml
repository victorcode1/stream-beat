<?xml version="1.0" encoding="utf-8"?>
<!--
  audio_service busca sus iconos por nombre (getIdentifier). Sin esto, el
  shrinking de recursos de release los borra y la sesion multimedia falla con
  "You must specify an icon resource id to build a CustomAction".
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/audio_service_*,@mipmap/ic_launcher" />
