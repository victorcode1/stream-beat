<?xml version="1.0" encoding="utf-8"?>
<!--
  Estos recursos solo se usan por nombre en tiempo de ejecución, así que el
  reductor de recursos los marca como no usados y los elimina en release:
  - audio_service busca sus iconos de controles con getIdentifier; sin ellos,
    la reproducción falla («You must specify an icon resource id»).
  - flutter_local_notifications usa ic_notification para el despertador y la
    recomendación diaria.
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/audio_service_*,@drawable/ic_notification" />
